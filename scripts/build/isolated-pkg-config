#!/bin/sh
# Minimal pkg-config shim for the isolated target sysroot.
# It intentionally exposes only libusb-1.0, which is the dependency queried
# by the OpenEB SDK-only build.
for arg in "$@"; do
    case "$arg" in
        --exists) exit 0 ;;
        --modversion) echo 1.0.24; exit 0 ;;
        --cflags|--cflags-only-I)
            echo "-I/data/tools/kria-build-root/usr/include/libusb-1.0"
            exit 0
            ;;
        --libs|--libs-only-L|--libs-only-l)
            echo "-L/data/tools/kria-build-root/lib -lusb-1.0"
            exit 0
            ;;
    esac
done
exit 0
